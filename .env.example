# ============================================================================
# VERIFY BEFORE USE — every value below marked VERIFY is an assumption.
# NVIDIA NIM model slugs are retired without notice and hosted pricing changes
# without warning. Validate at startup before trusting a run.
# ============================================================================

# --- secrets (never commit the real .env) -----------------------------------
# NVIDIA NIM API key from https://build.nvidia.com, sent as a bearer token.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- models -----------------------------------------------------------------
# Only poolside/laguna-xs-2.1 works for entity extraction on NIM (tested).
# It correctly extracts 28 entities from invoices in ~65s.
# Other models either fail (404/503), timeout, or return empty entities.

# Pipeline model
PIPELINE_MODEL_ID=poolside/laguna-xs-2.1
PIPELINE_MODEL_PROVIDER=poolside
PIPELINE_MODEL_FAMILY=poolside
PIPELINE_MODEL_PRICE_IN=0.0
PIPELINE_MODEL_PRICE_OUT=0.0
PIPELINE_MODEL_MAX_TOKENS=8192
PIPELINE_MODEL_IS_REASONING=false

# Pipeline fallback model
PIPELINE_FALLBACK_MODEL_ID=poolside/laguna-xs-2.1
PIPELINE_FALLBACK_MODEL_PROVIDER=poolside
PIPELINE_FALLBACK_MODEL_FAMILY=poolside
PIPELINE_FALLBACK_MODEL_PRICE_IN=0.0
PIPELINE_FALLBACK_MODEL_PRICE_OUT=0.0
PIPELINE_FALLBACK_MODEL_MAX_TOKENS=8192
PIPELINE_FALLBACK_MODEL_IS_REASONING=false

# Judge model (different family required by guard)
# Using meta/llama-3.1-8b-instruct as it's from a different family than poolside pipeline
JUDGE_MODEL_ID=meta/llama-3.1-8b-instruct
JUDGE_MODEL_PROVIDER=meta
JUDGE_MODEL_FAMILY=meta
JUDGE_MODEL_PRICE_IN=0.0
JUDGE_MODEL_PRICE_OUT=0.0
JUDGE_MODEL_MAX_TOKENS=4096

# Cheap model
CHEAP_MODEL_ID=nvidia/nemotron-3.5-content-safety
CHEAP_MODEL_PROVIDER=nvidia
CHEAP_MODEL_FAMILY=nvidia
CHEAP_MODEL_PRICE_IN=0.0
CHEAP_MODEL_PRICE_OUT=0.0
CHEAP_MODEL_MAX_TOKENS=4096
CHEAP_MODEL_IS_REASONING=false

# The judge above IS cross-family (meta vs poolside), so the family guard would
# pass. This flag is false only because the *duplicate-model-ID* guard is gated on
# the same switch, and this template deliberately reuses the pipeline model as its
# own fallback — no second pipeline slug has been verified to work on NIM (see the
# note above the model section). Set it to true once a second verified slug exists.
JUDGE_FAMILY_SEPARATION_REQUIRED=false

# Reasoning models need headroom
REQUEST_TIMEOUT_S=300
CONNECT_TIMEOUT_S=10

# --- cost control -----------------------------------------------------------
# Hard caps enforced in our own client, not provider-side.
SPEND_CAP_PER_RUN_USD=0.50
SPEND_CAP_GLOBAL_USD=20.00
CACHE_ENABLED=true
DRY_RUN=false

# --- paths ------------------------------------------------------------------
DATA_DIR=data
TRACES_DIR=data/traces
DB_PATH=data/forensics.db
DATASET_DIR=dataset
CACHE_DIR=data/cache
# Spend ledger. On a host with a persistent disk, point this at the disk: a
# ledger in the build directory resets the global spend cap on every redeploy.
SPEND_FILE=data/spend.json

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STATIC_DIR=frontend/dist
# Comma-separated browser origins allowed to call the API. Never `*`: the CORS
# middleware enables credentials, and a wildcard would let any page an operator
# visits drive the API with their key.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# --- judge LLM (optional semantic analysis) ---------------------------------
# Off by default: the deterministic checks decide, and the judge is extra
# evidence. Run a cross-family judge (see JUDGE_FAMILY_SEPARATION_REQUIRED).
JUDGE_ENABLED=false
# Run the judge even when every deterministic check passed.
JUDGE_FORCE=false

# --- PII redaction (persistence boundary) -----------------------------------
# When enabled, prompts/responses are redacted *before* the JSON and SQLite
# writes, so the original never reaches disk (spec 03).
PII_REDACTION_ENABLED=false
PII_ENTITY_TYPES=api_key,email,phone,credit_card,ssn,ipv4,jwt
# JSON array of extra patterns: [{"name": "...", "pattern": "...", "replacement": "..."}]
PII_CUSTOM_PATTERNS=
PII_REDACTION_CHAR=█

# --- OpenTelemetry ----------------------------------------------------------
# none (default) exports nothing. `console` prints spans to stdout.
OTEL_EXPORTER=none
OTEL_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=failure-forensics
OTEL_SAMPLING_RATE=1.0

# --- custom check plugins (spec 05) -----------------------------------------
# Comma-separated `module:attr` paths, e.g. my_checks:check_pii_in_summary
CHECK_PLUGINS=

# --- auth / multi-tenancy (spec 04) -----------------------------------------
# When enabled, every data endpoint requires `Authorization: Bearer ffk_...`.
AUTH_ENABLED=false
AUTH_API_KEY_PREFIX=ffk_
AUTH_BCRYPT_ROUNDS=12

# --- scheduled eval + alerting (spec 06) ------------------------------------
# Empty means no schedule. Cron, interpreted in EVAL_SCHEDULE_TIMEZONE.
EVAL_SCHEDULE=
EVAL_SCHEDULE_TIMEZONE=UTC
SCHEDULER_DB_PATH=data/scheduler.db
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Accuracy drop (as a fraction) that counts as a regression: 0.10 = 10 points.
ALERT_REGRESSION_THRESHOLD=0.10
ALERT_ON_FIXED=true

# --- worker queue (spec 07) -------------------------------------------------
# When enabled, POST /pipeline/run queues the document instead of running it
# inline, and `forensics worker start` consumes it.
QUEUE_ENABLED=false
QUEUE_WORKER_CONCURRENCY=2
QUEUE_POLL_INTERVAL=1.0
# Seconds a finished job is retained before `cleanup()` removes it.
QUEUE_JOB_TTL=86400

# --- versions (bump when behavior changes; regression tracking depends on these) ---
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1
ANALYZER_VERSION=0.1.0
