# ============================================================================
# VERIFY BEFORE USE — every value below marked VERIFY is an assumption.
# NVIDIA NIM model slugs are retired without notice and hosted pricing changes
# without warning. Validate at startup before trusting a run.
# ============================================================================

# --- secrets (never commit the real .env) -----------------------------------
# NVIDIA NIM API key from https://build.nvidia.com, sent as a bearer token.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- models -----------------------------------------------------------------
# VERIFY BEFORE USE: slugs, context windows, and pricing all change.
# Judge MUST come from a different family than both pipeline models
# (self-preference bias). config.py asserts this at startup and fails loudly.

# Pipeline model (cheap, high volume)
PIPELINE_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
PIPELINE_MODEL_PROVIDER=nvidia
PIPELINE_MODEL_FAMILY=nvidia
PIPELINE_MODEL_PRICE_IN=0.0
PIPELINE_MODEL_PRICE_OUT=0.0

# Pipeline fallback model
PIPELINE_FALLBACK_MODEL_ID=mistralai/mistral-large-2-instruct
PIPELINE_FALLBACK_MODEL_PROVIDER=mistralai
PIPELINE_FALLBACK_MODEL_FAMILY=mistralai
PIPELINE_FALLBACK_MODEL_PRICE_IN=0.0
PIPELINE_FALLBACK_MODEL_PRICE_OUT=0.0

# Judge model (stronger, different family from both pipeline models)
JUDGE_MODEL_ID=deepseek-ai/deepseek-v4.1-flash
JUDGE_MODEL_PROVIDER=deepseek-ai
JUDGE_MODEL_FAMILY=deepseek-ai
JUDGE_MODEL_PRICE_IN=0.0
JUDGE_MODEL_PRICE_OUT=0.0

# Cheap model for pre-checks
CHEAP_MODEL_ID=nvidia/nemotron-nano-3-30b-a3b
CHEAP_MODEL_PROVIDER=nvidia
CHEAP_MODEL_FAMILY=nvidia
CHEAP_MODEL_PRICE_IN=0.0
CHEAP_MODEL_PRICE_OUT=0.0

# --- cost control -----------------------------------------------------------
# Hard caps enforced in our own client, not provider-side.
SPEND_CAP_PER_RUN_USD=0.50
SPEND_CAP_GLOBAL_USD=20.00
CACHE_ENABLED=true
DRY_RUN=false

# --- paths ------------------------------------------------------------------
DATA_DIR=data
TRACES_DIR=data/traces
DB_PATH=data/forensics.db
DATASET_DIR=dataset
CACHE_DIR=data/cache

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STATIC_DIR=frontend/dist

# --- versions (bump when behavior changes; regression tracking depends on these) ---
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1
ANALYZER_VERSION=0.1.0
