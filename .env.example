# ============================================================================
# VERIFY BEFORE USE — every value below marked VERIFY is an assumption.
# OpenRouter model slugs change when providers are added or retired, and
# pricing changes without notice. Validate at startup before trusting a run.
# See PROMPT.md > provider_constraint_openrouter.
# ============================================================================

# --- secrets (never commit the real .env) -----------------------------------
# VERIFY BEFORE USE: confirm the exact header name OpenRouter expects.
OPENROUTER_API_KEY=

# --- models -----------------------------------------------------------------
# VERIFY BEFORE USE: slugs, context windows, and pricing all change.
# Judge MUST come from a different provider family than the pipeline models
# (self-preference bias). config.py asserts this at startup and fails loudly.

# Pipeline model (cheap, high volume) — e.g., openai/gpt-4o-mini
PIPELINE_MODEL_ID=openai/gpt-4o-mini
PIPELINE_MODEL_PROVIDER=openai
PIPELINE_MODEL_FAMILY=openai
PIPELINE_MODEL_PRICE_IN=0.15
PIPELINE_MODEL_PRICE_OUT=0.60

# Pipeline fallback model — e.g., anthropic/claude-3-haiku
PIPELINE_FALLBACK_MODEL_ID=anthropic/claude-3-haiku
PIPELINE_FALLBACK_MODEL_PROVIDER=anthropic
PIPELINE_FALLBACK_MODEL_FAMILY=anthropic
PIPELINE_FALLBACK_MODEL_PRICE_IN=0.25
PIPELINE_FALLBACK_MODEL_PRICE_OUT=1.25

# Judge model (stronger, different family) — e.g., google/gemini-1.5-pro
JUDGE_MODEL_ID=google/gemini-1.5-pro
JUDGE_MODEL_PROVIDER=google
JUDGE_MODEL_FAMILY=google
JUDGE_MODEL_PRICE_IN=3.50
JUDGE_MODEL_PRICE_OUT=10.50

# Cheap model for pre-checks — e.g., openai/gpt-3.5-turbo
CHEAP_MODEL_ID=openai/gpt-3.5-turbo
CHEAP_MODEL_PROVIDER=openai
CHEAP_MODEL_FAMILY=openai
CHEAP_MODEL_PRICE_IN=0.50
CHEAP_MODEL_PRICE_OUT=1.50

# --- cost control -----------------------------------------------------------
# Hard caps enforced in our own client, not provider-side.
SPEND_CAP_PER_RUN_USD=0.50
SPEND_CAP_GLOBAL_USD=20.00
CACHE_ENABLED=true
DRY_RUN=false

# --- paths ------------------------------------------------------------------
DATA_DIR=data
TRACES_DIR=data/traces
DB_PATH=data/forensics.db
DATASET_DIR=dataset
CACHE_DIR=data/cache

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STATIC_DIR=frontend/dist

# --- versions (bump when behavior changes; regression tracking depends on these) ---
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1
ANALYZER_VERSION=0.1.0
