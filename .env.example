# ============================================================================
# VERIFY BEFORE USE — every value below marked VERIFY is an assumption.
# NVIDIA NIM model slugs are retired without notice and hosted pricing changes
# without warning. Validate at startup before trusting a run.
# ============================================================================

# --- secrets (never commit the real .env) -----------------------------------
# NVIDIA NIM API key from https://build.nvidia.com, sent as a bearer token.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- models -----------------------------------------------------------------
# One model serves every role (pipeline, fallback, judge, cheap). NIM retired
# the slugs previously configured here; this one is live in the catalog.
# nemotron-3-super is a REASONING model: it spends hidden reasoning tokens out
# of the same budget, so *_MAX_TOKENS is raised well above the 4096 default.
# A too-small cap returns finish_reason="length" with an empty content string.

# Pipeline model
PIPELINE_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
PIPELINE_MODEL_PROVIDER=nvidia
PIPELINE_MODEL_FAMILY=nvidia
PIPELINE_MODEL_PRICE_IN=0.0
PIPELINE_MODEL_PRICE_OUT=0.0
PIPELINE_MODEL_MAX_TOKENS=16384

# Pipeline fallback model (same weights, so the fallback path only re-requests)
PIPELINE_FALLBACK_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
PIPELINE_FALLBACK_MODEL_PROVIDER=nvidia
PIPELINE_FALLBACK_MODEL_FAMILY=nvidia
PIPELINE_FALLBACK_MODEL_PRICE_IN=0.0
PIPELINE_FALLBACK_MODEL_PRICE_OUT=0.0
PIPELINE_FALLBACK_MODEL_MAX_TOKENS=16384

# Judge model (same weights as the pipeline: self-preference bias is accepted,
# see JUDGE_FAMILY_SEPARATION_REQUIRED below)
JUDGE_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
JUDGE_MODEL_PROVIDER=nvidia
JUDGE_MODEL_FAMILY=nvidia
JUDGE_MODEL_PRICE_IN=0.0
JUDGE_MODEL_PRICE_OUT=0.0
JUDGE_MODEL_MAX_TOKENS=16384

# Cheap model for pre-checks
CHEAP_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
CHEAP_MODEL_PROVIDER=nvidia
CHEAP_MODEL_FAMILY=nvidia
CHEAP_MODEL_PRICE_IN=0.0
CHEAP_MODEL_PRICE_OUT=0.0
CHEAP_MODEL_MAX_TOKENS=16384

# One model in every role, so the judge-family split is meaningless here.
# Set true to restore the strict guard.
JUDGE_FAMILY_SEPARATION_REQUIRED=false

# Reasoning models under a JSON schema take 70-110s on one document.
# The old fixed 60s timeout made every attempt fail, then retry 3x across 3 tiers.
REQUEST_TIMEOUT_S=300
CONNECT_TIMEOUT_S=10

# --- cost control -----------------------------------------------------------
# Hard caps enforced in our own client, not provider-side.
SPEND_CAP_PER_RUN_USD=0.50
SPEND_CAP_GLOBAL_USD=20.00
CACHE_ENABLED=true
DRY_RUN=false

# --- paths ------------------------------------------------------------------
DATA_DIR=data
TRACES_DIR=data/traces
DB_PATH=data/forensics.db
DATASET_DIR=dataset
CACHE_DIR=data/cache

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STATIC_DIR=frontend/dist

# --- versions (bump when behavior changes; regression tracking depends on these) ---
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1
ANALYZER_VERSION=0.1.0
