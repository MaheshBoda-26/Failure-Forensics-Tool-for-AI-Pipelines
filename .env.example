# ============================================================================
# VERIFY BEFORE USE — every value below marked VERIFY is an assumption.
# OpenRouter model slugs change when providers are added or retired, and
# pricing changes without notice. Validate at startup before trusting a run.
# See PROMPT.md > provider_constraint_openrouter.
# ============================================================================

# --- secrets (never commit the real .env) -----------------------------------
# VERIFY BEFORE USE: confirm the exact header name OpenRouter expects.
# Note: if the official `openai` SDK is pointed at a custom base URL it will
# still read an OPENAI_* env var — that would be misleading here. Decide the
# variable name deliberately in config.py rather than inheriting one.
OPENROUTER_API_KEY=

# --- models -----------------------------------------------------------------
# VERIFY BEFORE USE: slugs, context windows, and pricing all change.
# Judge MUST come from a different provider family than the pipeline models
# (self-preference bias). config.py asserts this at startup and fails loudly.
PIPELINE_MODEL=
PIPELINE_FALLBACK_MODEL=
JUDGE_MODEL=
CHEAP_MODEL=

# VERIFY BEFORE USE: pin the upstream provider so the same slug resolves to the
# same upstream for the life of a run. Without this, OpenRouter may route calls
# to different providers and silently break determinism and replay.
# Format is VERIFY BEFORE USE — check OpenRouter's current provider-routing docs.
PIPELINE_PROVIDER=
JUDGE_PROVIDER=

# --- pricing (USD per 1M tokens) — VERIFY BEFORE USE ------------------------
# Used only for the local spend cap and the cost audit log. Not billing truth.
PRICE_PIPELINE_IN=
PRICE_PIPELINE_OUT=
PRICE_JUDGE_IN=
PRICE_JUDGE_OUT=
PRICE_CHEAP_IN=
PRICE_CHEAP_OUT=

# --- cost control -----------------------------------------------------------
# Hard caps enforced in our own client, not provider-side.
SPEND_CAP_PER_RUN_USD=0.50
SPEND_CAP_GLOBAL_USD=20.00
CACHE_ENABLED=true
DRY_RUN=false

# --- paths ------------------------------------------------------------------
DATA_DIR=data
TRACES_DIR=data/traces
DB_PATH=data/forensics.db
DATASET_DIR=dataset

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
STATIC_DIR=frontend/dist

# --- versions (bump when behavior changes; regression tracking depends on these) ---
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1
ANALYZER_VERSION=0.1.0
